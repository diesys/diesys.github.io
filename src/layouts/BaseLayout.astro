---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/site.config';
import '@/styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import GradualBlur from '@/components/react/GradualBlur';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image = '/og-image.png' } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>

  <body
    id="top"
    class="bg-paper text-ink flex h-full min-h-screen w-dvw flex-col overflow-x-hidden"
  >
    <Header />

    <main class="grow">
      <slot />
    </main>

    <Footer />

    <GradualBlur
      client:visible
      aria-hidden="true"
      target="page"
      position="bottom"
      height="8rem"
      curve="bezier"
      exponential={true}
    />
  </body>
</html>
