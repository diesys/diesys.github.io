---
import ThemeToggle from '@/components/ThemeToggle.astro';
import MenuWheel from '@/components/react/MenuWheel';
import { SITE, NAV_LINKS } from '@/site.config';

const currentPath = Astro.url.pathname;

// Same entries as the inline nav below, so the wheel menu offers the same
// destinations without replacing the existing links.
const menuItems = [
  ...NAV_LINKS.map((link) => ({ label: link.label, href: link.href })),
  { label: 'Contact', href: '/#contact' },
];

const activeIndex = Math.max(
  0,
  NAV_LINKS.findIndex(
    (link) => currentPath === link.href || currentPath.startsWith(`${link.href}/`),
  ),
);
---

<header
  class="border-line bg-paper/20 sticky top-0 z-40 backdrop-blur-xl [mask:linear-gradient(white_50%,transparent)]"
>
  <!-- class="border-line bg-paper/20 sticky top-0 z-40 border-b backdrop-blur-lg" -->

  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="font-display text-ink text-lg font-medium">
      {SITE.name}
    </a>

    <nav class="flex items-center gap-5" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/#contact"
        class="text-ink-soft hover:text-ink hidden font-mono text-xs tracking-wide uppercase transition-colors sm:inline"
      >
        Contact
      </a>
      <ThemeToggle />
      <MenuWheel items={menuItems} defaultSelected={activeIndex} client:visible />
    </nav>
  </div>
</header>
