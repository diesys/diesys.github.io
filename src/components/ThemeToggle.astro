---
// Pairs with the no-FOUC inline script in BaseLayout's <head>: that script
// resolves the stored mode ('light' | 'dark' | 'auto', default 'auto') into
// the .dark class and the html[data-theme] attribute before first paint, and
// exposes window.__applyTheme. This component only handles the click-to-cycle
// interaction (light → dark → auto) after that, then re-applies via the
// shared helper. Icon visibility is driven by html[data-theme] (the .dark
// class alone cannot distinguish 'light' from 'auto').
//
// Icons are LineMD animated SVGs (see docs/icons.md). `moon-to-sunny-outline-transition`
// morphs moon → sunny outline on mount (used for light), while `moon` is a
// one-shot draw-in (used for dark). In 'auto' the icon shown is the one matching
// the currently resolved OS theme (sun on a light system, moon on a dark one),
// tinted with --signal to mark that the OS is being followed rather than a
// forced mode.
import IconMoonMorph from '~icons/line-md/moon-to-sunny-outline-transition';
import IconMoon from '~icons/line-md/moon';
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch theme"
  class="text-ink-soft hover:border-signal hover:text-signal border-line relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full border transition-colors"
>
  <IconMoonMorph class="icon icon-sun h-4 w-4" />
  <IconMoon class="icon icon-moon h-4 w-4" />
</button>

<style>
  .icon {
    display: none;
  }
  :global(html[data-theme='light']) .icon-sun,
  :global(html[data-theme='auto']:not(.dark)) .icon-sun {
    display: block;
  }
  :global(html[data-theme='dark']) .icon-moon,
  :global(html[data-theme='auto'].dark) .icon-moon {
    display: block;
  }

  /* In 'auto' the currently visible icon follows the OS theme, so tint it with
     --signal to signal that the mode is not forced. */
  :global(html[data-theme='auto']) .icon {
    color: var(--signal);
  }
</style>

<script>
  declare global {
    interface Window {
      __applyTheme?: () => void;
    }
  }

  function initThemeToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = 'true';
    const button = toggle;

    const STORAGE_KEY = 'theme';
    const MODES = ['light', 'dark', 'auto'] as const;
    const NEXT_LABEL: Record<(typeof MODES)[number], string> = {
      light: 'Switch to dark theme',
      dark: 'Switch to auto theme',
      auto: 'Switch to light theme',
    };

    function updateButton() {
      const mode =
        (document.documentElement.dataset.theme as (typeof MODES)[number] | undefined) ?? 'auto';
      button.setAttribute('aria-label', NEXT_LABEL[mode]);
    }

    // LineMD SVGs animate only when (re)mounted. On a mode change the CSS swap
    // just reveals a hidden <svg> without re-running its SMIL timeline, so the
    // icon now shown is explicitly rewound to its start and unpaused.
    function replayIcon(selector: string) {
      requestAnimationFrame(() => {
        const icon = button.querySelector<SVGSVGElement>(selector);
        icon?.setCurrentTime(0);
        icon?.unpauseAnimations();
      });
    }

    // In 'auto' the visible icon follows the resolved OS theme: sun on a light
    // system, moon on a dark one (the .dark class on <html> carries that).
    function visibleIcon(mode: (typeof MODES)[number]): string {
      if (mode === 'light') return '.icon-sun';
      if (mode === 'dark') return '.icon-moon';
      return document.documentElement.classList.contains('dark') ? '.icon-moon' : '.icon-sun';
    }

    updateButton();

    button.addEventListener('click', () => {
      const current =
        (document.documentElement.dataset.theme as (typeof MODES)[number] | undefined) ?? 'auto';
      const next = MODES[(MODES.indexOf(current) + 1) % MODES.length];
      localStorage.setItem(STORAGE_KEY, next);
      window.__applyTheme?.();
      updateButton();
      replayIcon(visibleIcon(next));
    });
  }

  // astro:page-load fires on the first load AND after every client-side
  // navigation done by <ClientRouter />, so the button stays wired up.
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
