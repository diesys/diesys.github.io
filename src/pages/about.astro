---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = [
  'TypeScript',
  'Astro',
  'React',
  'Figma',
  'Tailwind CSS',
  'Node.js',
  'HTML',
  'CSS',
  'Angular',
  'Playwright',
  'Vue',
  'Svelte',
  'PrimeNG',
  'Ant Design',
  'GSAP',
  'ReactPDF',
  'Bun',
  'Symfony',
  'Docker',
  'Python',
  'Git',
  'Shell',
  'Lottie',
  'Rive',
];

const coreCompetencies = [
  'Brand',
  'UI/UX',
  'Design Systems',
  'Product Design',
  'QA',
  'Technical Docs',
  'Responsive Web',
  'Client Communication',
  'Board Management',
  'Cross-functional Team Leadership',
];

const languages = ['Italian (native)', 'English (C1)'];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I start most projects by trying to find the smallest version of the problem — the one
        screen, one flow, or one fix that actually matters — and build that first, properly, before
        expanding outward.
      </p>
      <p>
        That usually means fewer features than a kickoff deck promises, and more attention to the
        parts people interact with constantly: load times, empty states, error messages, the things
        that quietly decide whether software feels good to use.
      </p>
      <p>
        Outside of client and product work, I maintain a couple of small open-source tools and write
        occasional notes on what I learn building them.
      </p>
      <p>
        I'm a full-stack creator bridging web development, design and CSS skills. I started as a
        graphic designer before studying computer science and digital humanities. I'm
        curiosity-driven, detail-oriented — I plan, test, iterate, and refine across the product's
        lifecycle, from design to QA. My goal is to define design choices that produce less and
        cleaner code, to proactively prevent bugs and unlock new features with ease. I balance
        usability, beauty and do-ability to empower users and developers, with better workflows for
        teams and more consistent, enjoyable products.
      </p>
      <p>
        Born near the <a href="https://en.wikipedia.org/wiki/Hyblaean_Mountains">Iblei</a>
        mountains, between Comiso and Vittoria, now based in Pisa, Toscana. Previously full-time Front-End
        UI/UX Dev, Designer, QA at <a href="https://www.geckosoft.it/">Geckosoft</a>
        (2021–2026), now self-employed. <a href="http://www.fileli.unipi.it/infouma/"
          >Digital Humanities</a
        > student, former <a href="http://www.di.unipi.it">Computer Science</a> student.
      </p>
      <p>
        Also a photographer, former <a href="https://www.facebook.com/pg/asa25circolo">Asa25</a>
        member and music passionate — guitar as main instrument. Took part in
        <a href="https://www.facebook.com/labpermanentetda/"
          >laboratorio permanente del teatro dell'assedio</a
        > and a play by <a href="https://www.facebook.com/vocisbagliate/">Voci Sbagliate</a>.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">
        Core Competencies
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          coreCompetencies.map((item) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-8">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Languages</p>
      <ul class="flex flex-wrap gap-2">
        {
          languages.map((lang) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {lang}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>
