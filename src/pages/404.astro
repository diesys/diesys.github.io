---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FuzzyText from '@/components/react/FuzzyText';
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex max-w-3xl flex-col items-start gap-4 px-6 py-32">
    <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">404</p>
    <h1 class="font-display text-ink relative text-3xl font-medium">
      <span class="sr-only">This page doesn't exist.</span>
      <FuzzyText
        client:visible
        text="This page doesn't exist."
        fontSize="clamp(1.4rem, 4.5vw, 2.5rem)"
        fontWeight={500}
        className="block"
      />
    </h1>
    <p class="text-ink-soft">The link might be broken, or the page may have moved.</p>
    <a href="/" class="text-signal font-mono text-sm hover:underline">← Back home</a>
  </section>
</BaseLayout>
